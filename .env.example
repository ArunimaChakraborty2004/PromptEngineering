# Nova — Intelligent Personal Productivity & Knowledge Assistant
# Environment configuration template.
# Copy this file to `.env.local` and fill in the values.

# Required: Groq API key for LLM inference.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Groq model used for chat. Must support tool calling.
# Confirmed tool-calling models on Groq: qwen/qwen3.8-27b, qwen/qwen3.6-27b, openai/gpt-oss-120b
# NOTE: groq/compound does NOT support tool calling.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: OpenWeatherMap API key for richer weather data.
# If unset, Nova falls back to wttr.in (no key required).
# OPENWEATHER_API_KEY=